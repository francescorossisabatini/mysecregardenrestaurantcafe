        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "language": {
              "type": "string",
              "enum": [
                "de",
                "en"
              ],
              "default": "de",
              "description": "Language of the menu: German (de) or English (en)."
